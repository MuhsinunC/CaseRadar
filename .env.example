# CaseRadar Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database (Supabase)
# ============================================
# Get from Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for migrations (no pgbouncer)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ============================================
# Authentication (Clerk)
# ============================================
# Get from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ============================================
# Billing (Stripe)
# ============================================
# Get from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ============================================
# AI Services
# ============================================
# OpenAI for embeddings (production fallback)
OPENAI_API_KEY="sk-..."

# Anthropic for complaint generation
ANTHROPIC_API_KEY="sk-ant-..."

# Local Embedding Service (development)
# For Kubernetes with port-forward: http://localhost:8090 (run: k8s/embedding-service/start.sh)
# For production K8s (in-cluster): http://embedding-service.embedding.svc.cluster.local
# Leave empty to use OpenAI embeddings
EMBEDDING_SERVICE_URL="http://localhost:8090"

# ============================================
# External APIs
# ============================================
# NHTSA API (public, no key required)
NHTSA_API_BASE_URL="https://api.nhtsa.gov"

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@caseradar.com"

# ============================================
# Cron Jobs
# ============================================
# Secret for authenticating cron job requests
CRON_SECRET="your-cron-secret-here"

# ============================================
# Monitoring & Error Tracking
# ============================================
# Sentry for error tracking
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================
# Feature Flags
# ============================================
# Enable/disable features
ENABLE_ANALYTICS="true"
ENABLE_EMAIL_NOTIFICATIONS="true"

# ============================================
# Rate Limiting
# ============================================
# Redis URL for rate limiting (optional - falls back to memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
