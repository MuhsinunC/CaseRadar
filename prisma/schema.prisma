// CaseRadar Prisma Schema
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ============================================
// Multi-tenancy
// ============================================

model Organization {
  id         String   @id @default(cuid())
  name       String
  clerkOrgId String   @unique
  plan       Plan     @default(FREE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  patterns            Pattern[]
  generatedComplaints GeneratedComplaint[]
  subscription        Subscription?
  auditLogs           AuditLog[]
  legalHolds          LegalHold[]
  clusteringRuns      ClusteringRun[]

  @@index([clerkOrgId])
}

model User {
  id             String       @id @default(cuid())
  clerkUserId    String       @unique
  email          String
  role           Role         @default(VIEWER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // GDPR soft-delete support
  deletedAt      DateTime?
  isDeleted      Boolean      @default(false)

  @@index([organizationId])
  @@index([clerkUserId])
  @@index([isDeleted])
}

// ============================================
// NHTSA Complaint Data
// ============================================

model Complaint {
  id           String    @id @default(cuid())
  nhtsaId      String    @unique // CMPLID from NHTSA
  odiNumber    String // ODINO from NHTSA
  manufacturer String
  make         String
  model        String
  year         Int? // Nullable for equipment without model years (e.g., charging stations)
  component    String
  description  String    @db.Text
  crash        Boolean   @default(false)
  fire         Boolean   @default(false)
  injuries     Int       @default(0)
  deaths       Int       @default(0)
  failDate     DateTime?
  dateAdded    DateTime

  // Vector embedding for semantic search (768 dimensions for nomic-embed-text)
  embedding Unsupported("vector(768)")?

  // Cluster/Pattern assignment
  clusterId String?
  cluster   Pattern? @relation(fields: [clusterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([make, model, year])
  @@index([component])
  @@index([dateAdded])
  @@index([clusterId])
}

// ============================================
// NHTSA Recalls Data
// ============================================

model Recall {
  id                   String   @id @default(cuid())
  nhtsaCampaignNumber  String   @unique // NHTSA Campaign Number (e.g., "24V123")
  manufacturer         String
  make                 String
  model                String
  year                 Int
  component            String
  summary              String   @db.Text
  consequence          String   @db.Text
  remedy               String   @db.Text
  notes                String?  @db.Text
  reportReceivedDate   DateTime
  parkIt               Boolean  @default(false) // "Stop driving" severity
  parkOutside          Boolean  @default(false) // Fire hazard indicator

  // Vector embedding for semantic matching (768 dimensions for nomic-embed-text)
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cross-reference with patterns
  patterns PatternRecall[]

  // Matched leads
  leads    Lead[]

  @@index([make, model, year])
  @@index([component])
  @@index([reportReceivedDate])
  @@index([nhtsaCampaignNumber])
}

// ============================================
// Pattern-Recall Cross Reference
// ============================================

model PatternRecall {
  id        String   @id @default(cuid())
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  recallId  String
  recall    Recall   @relation(fields: [recallId], references: [id], onDelete: Cascade)

  // Match confidence/relevance
  matchScore   Float   @default(0) // 0-1 confidence that recall addresses this pattern
  matchReason  String? // Why this recall was linked (component match, description match, etc.)

  createdAt DateTime @default(now())

  @@unique([patternId, recallId])
  @@index([patternId])
  @@index([recallId])
}

// ============================================
// Pattern/Cluster Analysis
// ============================================

model Pattern {
  id          String  @id @default(cuid())
  name        String // Auto-generated from top terms
  description String?
  make        String
  model       String?
  yearStart   Int?
  yearEnd     Int?
  component   String

  // Aggregate statistics
  complaintCount Int @default(0)
  crashCount     Int @default(0)
  fireCount      Int @default(0)
  injuryCount    Int @default(0)
  deathCount     Int @default(0)

  // Scoring for prioritization
  severityScore  Float        @default(0)
  trendScore     Float        @default(0) // Rate of increase over time
  trendDirection TrendDirection @default(STABLE)

  // Tracking
  firstSeen   DateTime
  lastUpdated DateTime
  isActive    Boolean  @default(true)

  // Relations
  complaints          Complaint[]
  generatedComplaints GeneratedComplaint[]
  recalls             PatternRecall[]  // Cross-reference with NHTSA recalls
  leads               Lead[]           // Generated leads from this pattern

  // Clustering audit trail
  clusteringRunId String?
  clusteringRun   ClusteringRun? @relation(fields: [clusteringRunId], references: [id])

  // Tenant visibility (null = global, otherwise org-specific)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severityScore])
  @@index([trendScore])
  @@index([make, model])
  @@index([component])
  @@index([organizationId])
  @@index([clusteringRunId])
}

// ============================================
// Clustering Run Audit Trail
// ============================================

model ClusteringRun {
  id                  String   @id @default(cuid())
  algorithmVersion    String   // Version of clustering algorithm
  randomSeed          Int      // Seed for reproducibility
  minClusterSize      Int      // Minimum cluster size parameter
  similarityThreshold Float    // Threshold for similarity
  inputComplaintCount Int      // Number of input complaints
  inputComplaintIds   String[] // IDs for replay capability
  outputPatternCount  Int      // Number of patterns created
  outputPatternIds    String[] // IDs of created patterns
  durationMs          Int      // How long the run took
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  createdBy           String   // Clerk user ID
  createdAt           DateTime @default(now())

  patterns Pattern[]

  @@index([organizationId])
  @@index([createdAt])
  @@index([algorithmVersion])
}

// ============================================
// Generated Legal Complaints
// ============================================

model GeneratedComplaint {
  id             String       @id @default(cuid())
  patternId      String
  pattern        Pattern      @relation(fields: [patternId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Content
  title   String
  content Json   // Structured complaint data (sections, plaintiff info, etc.)
  pdfUrl  String? // Supabase Storage URL for generated PDF

  // Metadata
  status      ComplaintStatus @default(DRAFT)
  version     Int             @default(1)
  contentHash String?         // SHA-256 hash for integrity verification
  legalHold   Boolean         @default(false) // If true, cannot be deleted

  // AI Version tracking for audit trail
  aiVersionId String?
  aiVersion   AIVersion? @relation(fields: [aiVersionId], references: [id])

  // GDPR soft-delete support
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String // Clerk user ID

  @@index([organizationId])
  @@index([patternId])
  @@index([status])
  @@index([createdAt])
  @@index([legalHold])
  @@index([deletedAt])
  @@index([aiVersionId])
}

// ============================================
// AI Version Tracking
// ============================================

model AIVersion {
  id             String   @id @default(cuid())
  modelProvider  String   // 'openai' | 'anthropic'
  modelVersion   String   // e.g., 'claude-3-opus-20240229'
  promptVersion  String   // e.g., 'v2.1.0'
  promptHash     String   // SHA-256 of prompt template
  embeddingModel String   // e.g., 'text-embedding-3-small'
  parameters     Json?    // temperature, max_tokens, etc.
  createdAt      DateTime @default(now())

  generations GeneratedComplaint[]

  @@index([modelVersion])
  @@index([promptVersion])
  @@index([promptHash])
}

// ============================================
// Billing (Stripe Integration)
// ============================================

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeCustomerId     String  @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Audit Logging
// ============================================

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  action         String // CREATE, UPDATE, DELETE, VIEW, EXPORT, LOGIN, LOGOUT, LOGIN_FAILED, etc.
  resource       String // USER, ORGANIZATION, COMPLAINT, PATTERN, AUTH, BILLING, etc.
  resourceId     String?
  metadata       Json? // Additional context (sensitive data is filtered)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource])
}

// ============================================
// Webhook Idempotency (Security)
// ============================================

model ProcessedWebhook {
  id          String   @id // Webhook ID from provider (svix-id or stripe event id)
  provider    String   // 'clerk' or 'stripe'
  eventType   String   // e.g., 'user.created', 'invoice.paid'
  processedAt DateTime @default(now())
  expiresAt   DateTime // Auto-cleanup after 30 days

  @@index([provider, eventType])
  @@index([expiresAt])
}

// ============================================
// Legal Hold (e-Discovery Support)
// ============================================

model LegalHold {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matterName     String       // Case reference
  description    String?      @db.Text
  issuedAt       DateTime     @default(now())
  releasedAt     DateTime?
  issuedBy       String       // User ID who issued the hold
  releasedBy     String?      // User ID who released the hold
  status         LegalHoldStatus @default(ACTIVE)

  scopes LegalHoldScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model LegalHoldScope {
  id           String    @id @default(cuid())
  legalHoldId  String
  legalHold    LegalHold @relation(fields: [legalHoldId], references: [id], onDelete: Cascade)
  resourceType String    // 'PATTERN', 'GENERATED', 'USER'
  resourceId   String?   // null means all resources of type
  custodianId  String?   // User ID if custodian-specific

  createdAt DateTime @default(now())

  @@index([legalHoldId])
  @@index([resourceType, resourceId])
}

// ============================================
// Enums
// ============================================

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum ComplaintStatus {
  DRAFT
  FINALIZED
  FILED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

enum TrendDirection {
  INCREASING
  DECREASING
  STABLE
}

enum LegalHoldStatus {
  ISSUED    // Initial state when hold is created
  ACTIVE    // Hold is actively enforced
  SUSPENDED // Temporarily suspended
  RELEASED  // Hold has been released
}

// ============================================
// GDPR Data Export Log
// ============================================

model DataExportLog {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  format         String       // 'json' or 'csv'
  status         String       @default("COMPLETED")
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([organizationId])
}

// ============================================
// Lead Generation (from Patterns)
// ============================================

model Lead {
  id              String    @id @default(cuid())

  // Source pattern
  patternId       String
  pattern         Pattern   @relation(fields: [patternId], references: [id], onDelete: Cascade)

  // Lead details
  title           String
  description     String    @db.Text
  make            String
  model           String?
  component       String
  yearStart       Int?
  yearEnd         Int?

  // Scoring
  severityScore   Int       @default(0)
  confidenceScore Float     @default(0)
  priorityScore   Float     @default(0)

  // Metrics
  complaintCount  Int       @default(0)
  deathCount      Int       @default(0)
  injuryCount     Int       @default(0)
  crashCount      Int       @default(0)
  fireCount       Int       @default(0)

  // Status
  status          LeadStatus @default(NEW)
  reviewedAt      DateTime?
  reviewedBy      String?
  notes           String?   @db.Text

  // Recall matching
  matchedRecallId String?
  matchedRecall   Recall?   @relation(fields: [matchedRecallId], references: [id])

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([severityScore])
  @@index([priorityScore])
  @@index([make, model])
  @@index([patternId])
  @@index([matchedRecallId])
}

enum LeadStatus {
  NEW
  REVIEWING
  CONFIRMED
  DISMISSED
  ESCALATED
}

// ============================================
// Pipeline Run Tracking
// ============================================

model PipelineRun {
  id              String    @id @default(cuid())

  // Run details
  mode            String    // 'full' | 'incremental'
  triggeredBy     String    // 'cron' | 'api' | 'manual'

  // Stage results (JSON objects)
  ingestResult    Json?
  embedResult     Json?
  patternResult   Json?
  leadResult      Json?

  // Metrics
  totalRecords    Int       @default(0)
  totalDuration   Int       @default(0)  // milliseconds

  // Status
  status          PipelineStatus @default(RUNNING)
  errorMessage    String?   @db.Text

  // Timestamps
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status])
  @@index([startedAt])
  @@index([triggeredBy])
}

enum PipelineStatus {
  RUNNING
  COMPLETED
  FAILED
}
